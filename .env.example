# LOCAL PROTOTYPE: don't copy this by hand. `npm run local:setup` writes .env.local with local values and
# random secrets. This file documents every variable, including the ones only needed at "Going live".
AUTH_MODE=local                      # local = "Sign in as" page (localhost only); clerk = Clerk (Going live)
# AUTH_MODE=local must never sit behind a reverse proxy or tunnel (ngrok, nginx, ...): see SECURITY.md "Staff sign-in".
LOCAL_PG_PORT=54329                  # embedded Postgres (generated values)
LOCAL_PG_PASSWORD=
LOCAL_APP_DB_PASSWORD=

# --- Database (Postgres; prefer a Canadian region, e.g. Supabase ca-central-1) ---
# App connection: role accessloop_app (NOSUPERUSER NOBYPASSRLS), transaction pooler. The server refuses to start if
# this role is a superuser or has BYPASSRLS (instrumentation.ts). A REMOTE database needs TLS: end the URL with
# ?sslmode=require (on Vercel the app refuses to start without sslmode=require or verify-full).
DATABASE_URL=postgres://accessloop_app:CHANGE_ME@HOST:6543/postgres?sslmode=require
# Owner connection: `npm run db:deploy` (migrations + db/sql/0100_security.sql), drizzle-kit, seed --reset.
# Use Supabase's SESSION pooler URL (port 5432 on the pooler host): the direct db.<ref>.supabase.co host is IPv6-only.
MIGRATION_DATABASE_URL=postgres://postgres.PROJECTREF:CHANGE_ME@POOLER_HOST:5432/postgres?sslmode=require

# --- Clerk (staff only) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...   # same value; @clerk/testing reads this name

# --- Secrets: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_SECRET=                      # required in EVERY AUTH_MODE: local-session cookie + intake preview-token MAC
RECEIPT_PEPPER=
IP_SALT=
# Every secret above: at least 32 characters (ENCRYPTION_KEY: base64 of exactly 32 bytes). lib/env.ts checks them at
# startup and names what is missing or malformed (never the value).
# Phase 7 secrets. In AUTH_MODE=local on this computer, a missing one is DERIVED from SESSION_SECRET (HKDF-SHA256,
# info = the variable's name), so an existing .env.local keeps working. On Vercel or in AUTH_MODE=clerk each must be set.
RETEST_LINK_SECRET=                  # one-time re-test links (/r/t/...): random, 32+ characters
CRON_SECRET=                         # Authorization: Bearer for /api/cron/daily (Vercel Cron sends it): random, 32+ characters
# Report signing key (docs/domain.md §8 "Signed at sign-off"): Ed25519 private key, PKCS#8 DER, base64.
# Make one with: node tools/signing-key.mjs --write <env file>. Public key: /.well-known/accessloop-signing-keys.json
REPORT_SIGNING_KEY=
REPORT_SIGNING_KEY_CREATED=          # optional: when that key was made (YYYY-MM-DD or ISO), shown in the key list

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_STRUCTURE=claude-sonnet-5-5
MODEL_PII=claude-haiku-5-5
MODEL_REPORT=claude-sonnet-5-5
MODEL_SIMILAR=                       # "Similar past barriers" (domain §6.2): empty = the MODEL_PII model
AI_BACKEND=fake                      # fake | claude-cli (your own local dev only, see domain §6.1) | api
# claude-cli backend (README "Real AI on your own machine"). Real AI needs BOTH FAKE_LLM=0 and AI_BACKEND=claude-cli.
# CLAUDE_CLI_PATH: empty = find it: `claude` on PATH (claude.exe, or the npm package's cli.js), else on Windows the
# newest copy the Claude desktop app keeps in %LOCALAPPDATA%\Claude-Data\*\claude-code\<version>\*\claude.exe.
# Set it (full path to claude.exe or cli.js) to use exactly that one. Sign the CLI in once yourself with the
# team's own claude.ai account: `<that path> auth login` (AccessLoop never signs in for you). Which flags it sends
# (--system-prompt-file or --system-prompt, --max-turns, --safe-mode) come from the CLI's own --help.
CLAUDE_CLI_PATH=
CLAUDE_CLI_MODEL=sonnet              # claude-cli backend: model alias
# api backend request shape (docs/decisions.md 2026-10-20 "api request shape", checked against Anthropic's docs that
# day). The defaults work on the default models: claude-opus-5-5 and claude-sonnet-5-5 reject a forced tool_choice,
# and sonnet/opus/haiku 5.5 reject a temperature other than their default. lib/ai/models.json "families" says what
# each known model accepts; a knob set here that the model rejects stops with a clear AiConfigError before any call.
# Unset (empty) = the default shown in the comment.
AI_API_TOOL_CHOICE=auto              # auto (default) | tool (only for models that accept a forced tool, e.g. haiku)
AI_API_TEMPERATURE=default           # default (send none) | 0..1 (only for models that accept one)
AI_API_EFFORT_STRUCTURE=low          # output_config.effort for structure: low (default) | medium | high | xhigh | max | default (send none)
AI_API_EFFORT_PII=                   # flagPii: empty = the model's own default | low .. max | default
AI_API_EFFORT_REPORT=                # phraseClaims: empty = the model's own default | low .. max | default
AI_API_EFFORT=                       # all three at once, where the function's own knob is empty
AI_API_STRICT_TOOLS=                 # empty = strict: true on the models known to accept it | 1 | 0
# One retry with jittered backoff on HTTP 429/529 inside the 10 s budget per call; intake's AI steps share one budget
# (10 s end to end on api, 60 s on claude-cli). Latency and token usage per call go into eval results (never text).
FAKE_LLM=0                          # 1 forces the fake backend whatever AI_BACKEND says. Vercel PREVIEW env: set to 1
# Eval prices: /app/eval's cost per report for api runs (lib/eval/usage.ts). Not secrets. Copy them from Anthropic's
# pricing page and set the date you did it; the page prints that date next to every cost. Format, comma-separated:
# <model id>=<input>/<output>[/<cache read>[/<cache write>]] in US dollars per million tokens. A model without an
# entry shows "Not shown" instead of a guess. The example values are the list prices for the default models as cached
# in Anthropic's model table on 2026-10-06 (Claude Haiku 5.5: prompts up to 100K tokens): check them before quoting.
AI_PRICES_USD_PER_MTOK=claude-sonnet-5-5=2/10,claude-haiku-5-5=0.1/0.5
AI_PRICES_SET_ON=                    # YYYY-MM-DD, the day you checked the prices above (empty = no cost shown)

# --- Email (Resend, verified sending domain) ---
RESEND_API_KEY=
EMAIL_FROM="AccessLoop <noreply@mail.your-domain.ca>"
FAKE_EMAIL=0                         # 1 = log only, send nothing. Vercel PREVIEW env: set to 1

# --- App ---
# The address in emails, downloaded receipts and a report's evidence-check line (lib/app-url.ts), read at RUN time.
# Unset: Vercel's production domain on a production deployment, else the deployment's own URL, else
# http://localhost:$PORT. Self-hosted in clerk mode it is required (lib/env.ts). An origin only, https on Vercel.
APP_URL=
# NEXT_PUBLIC_APP_URL is no longer read (Next inlined it at build time); local:setup still writes it, harmlessly.

# --- Abuse and spend limits (lib/rate-limit.ts) ---
# Per-address limits count Vercel's x-real-ip on Vercel, else the LAST X-Forwarded-For entry. Self-hosted, put the app
# behind a reverse proxy that APPENDS the client address to X-Forwarded-For, or a client picks its own bucket.
AI_GLOBAL_HOURLY_LIMIT=300           # real AI calls per hour from the public report form, all visitors and orgs; past it,
                                     # reports take the manual path (no AI). 0 = the form never calls AI. Fake AI: not counted
ORG_DAILY_SUBMISSION_LIMIT=200       # web reports one org's form accepts per day (Toronto time); shown on the dashboard

# --- Daily job (app/api/cron/daily; vercel.json runs it once a day with Authorization: Bearer $CRON_SECRET) ---
# It sends each re-test round's one reminder a week after the request and alerts owners about stalled or past-due
# cases. It expires re-test rounds open for 60 days ONLY when this is 1 (docs/domain.md §10: not before demo day).
CRON_EXPIRE_RETEST=0
# Retention (`npm run db:retention`, dry run; add `-- --apply` to write) runs as the owner (MIGRATION_DATABASE_URL).

# --- Seed (IDs from the Clerk DEV dashboard) ---
SEED_CLERK_ORG_ID_DEMO=org_...
SEED_CLERK_ORG_ID_OTHER=org_...
SEED_LEAD_USER_ID=user_...
SEED_OWNER_WEB_USER_ID=user_...
SEED_OWNER_FACILITIES_USER_ID=user_...
SEED_OTHER_LEAD_USER_ID=user_...
SEED_AUDITOR_USER_ID=user_...
# Optional: the made-up scenario org Kestrel Bay Group (data/scenarios.json). Unset = local IDs, which suit AUTH_MODE=local
SEED_CLERK_ORG_ID_SCENARIOS=org_...
SEED_SCENARIO_LEAD_USER_ID=user_...
SEED_SCENARIO_OWNER_USER_ID=user_...
SEED_ALLOW_RESET=1                  # dev/demo DB only. Production .env must have 0

# --- E2E (Clerk DEV test users; emails can use the +clerk_test suffix) ---
E2E_BASE_URL=http://localhost:3000
E2E_LEAD_EMAIL=lead+clerk_test@example.com
E2E_OWNER_EMAIL=facilities+clerk_test@example.com
E2E_OTHER_LEAD_EMAIL=otherlead+clerk_test@example.com
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Eval holdout (OUTSIDE the project folder; humans only) ---
HOLDOUT_PATH=../accessloop-holdout/reports.json
