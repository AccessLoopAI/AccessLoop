{
  "name": "accessloop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "local:setup": "tsx scripts/local-run.ts setup",
    "local": "tsx scripts/local-run.ts dev",
    "local:serve": "tsx scripts/local-run.ts serve",
    "local:db": "tsx scripts/local-run.ts db",
    "local:reset": "tsx scripts/local-run.ts reset",
    "e2e": "playwright test",
    "eval": "tsx --env-file-if-exists=.env.local eval/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:security": "tsx --env-file-if-exists=.env.local scripts/apply-sql.ts db/sql/0100_security.sql",
    "db:deploy": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:retention": "tsx --env-file-if-exists=.env.local scripts/retention.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local db/seed.ts",
    "db:smoke": "tsx scripts/db-smoke-run.ts",
    "db:remote-smoke": "tsx --env-file-if-exists=.env.local scripts/remote-smoke.ts",
    "load:check": "tsx --env-file-if-exists=.env.local scripts/load-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.47",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.9.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
